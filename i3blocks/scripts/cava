#!/bin/bash

# Configuração temporária do cava para i3blocks
CAVA_CONFIG="/tmp/cava_i3blocks_$$.conf"

cat > "$CAVA_CONFIG" << 'EOF'
[general]
bars = 8
framerate = 30

[input]
method = pulse

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7

[smoothing]
noise_reduction = 70
EOF

# Executa cava e formata a saída
cava -p "$CAVA_CONFIG" 2>/dev/null | while IFS= read -r -n8 data; do
    output=""
    # Lê cada caractere da string
    for ((i=0; i<${#data}; i++)); do
        char="${data:$i:1}"
        # Converte o caractere ASCII em número
        num=$(printf "%d" "'$char")
        # Mapeia para blocos visuais (0-7)
        case $((num % 8)) in
            0) output+=" " ;;
            1) output+="▁" ;;
            2) output+="▂" ;;
            3) output+="▃" ;;
            4) output+="▄" ;;
            5) output+="▅" ;;
            6) output+="▆" ;;
            7) output+="▇" ;;
        esac
    done
    echo "$output"
done

# Limpa arquivo temporário ao sair
trap "rm -f $CAVA_CONFIG" EXIT
